# 19Network News Intelligence Studio - Environment Template
# Note: The platform is completely operational in free/standalone mode without paid APIs.

# Optional WordPress REST API Integration (Server-Side only)
# For publishing drafts to your WordPress instance:
WORDPRESS_SITE_URL=https://www.19network.com
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Optional LLM integration (defaults to high-speed deterministic newsroom generator when omitted)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Application Timezone (Defaults to UAE Gulf Standard Time)
DEFAULT_TIMEZONE=Asia/Dubai
